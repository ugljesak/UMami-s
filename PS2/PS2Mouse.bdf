(text "Consts" (rect -384 112 -343 125)(font "Arial" (font_size 8)))
(text "Around 6000 ~ 120us" (rect 32 864 154 877)(font "Arial" (font_size 8)))
(text "0xF4 = 11110100" (rect 968 1160 1068 1173)(font "Arial" (font_size 8)))
(text "Full code:10111101000" (rect 968 1176 1101 1189)(font "Arial" (font_size 8)))
(text "Around 5000 ~ 20us" (rect 0 992 115 1005)(font "Arial" (font_size 8)))
(text "The final data extracted from the mouse" (rect 1648 472 1872 485)(font "Arial" (font_size 8)))
(text "Status shows button clicks LMB-0, RMB-1, MMB-2" (rect 1648 488 1931 501)(font "Arial" (font_size 8)))
(text "xNew and yNew show current mouse pos (0-255)" (rect 1648 504 1924 517)(font "Arial" (font_size 8)))
(text "Calculation of X mouse position" (rect 1016 264 1194 277)(font "Arial" (font_size 8)))
(text "x Sign bit" (rect 1368 80 1421 93)(font "Arial" (font_size 8)))
(text "Calculation of Y mouse position" (rect 1016 496 1194 509)(font "Arial" (font_size 8)))
(text "y Sign bit" (rect 1368 312 1421 325)(font "Arial" (font_size 8)))
(text "X and Y limits so we can't go below 0 and above 255" (rect 1008 896 1303 909)(font "Arial" (font_size 8)))
(text "X and Y movement transformation" (rect 1432 544 1624 557)(font "Arial" (font_size 8)))
(text "We sum them and get the position on a" (rect 1432 560 1652 573)(font "Arial" (font_size 8)))
(text "255x255 plane which makes getting cursor" (rect 1432 576 1671 589)(font "Arial" (font_size 8)))
(text "position easier in software later since the" (rect 1432 592 1660 605)(font "Arial" (font_size 8)))
(text "calculation is done here" (rect 1432 608 1565 621)(font "Arial" (font_size 8)))
(text "Start signal that makes sure all REGs and FFs are 0" (rect -384 768 -92 781)(font "Arial" (font_size 8)))
(text "and then starts the initialization" (rect -384 784 -210 797)(font "Arial" (font_size 8)))
(text "PS2 clock and data stabilisation. We negate the PS2 clock because its active at 0 which is dumb" (rect 24 760 562 773)(font "Arial" (font_size 8)))
(text "The debouncer checks for 16 consecutive same values(very small compared to tick duration of the PS2 clk)" (rect 24 776 621 789)(font "Arial" (font_size 8)))
(text "if clk fell" (rect 448 640 494 653)(font "Arial" (font_size 8)))
(text "are we ready to write the data bit into our buffer reg" (rect 328 608 614 621)(font "Arial" (font_size 8)))
(text "I/O" (rect -384 528 -366 541)(font "Arial" (font_size 8)))
(text "Tri bufs so we can send init data to the mouse" (rect -272 216 -14 229)(font "Arial" (font_size 8)))
(text "Mouse data buffer. " (rect -40 496 68 509)(font "Arial" (font_size 8)))
(text "Stores 3 mouse data packets" (rect 832 184 996 197)(font "Arial" (font_size 8)))
(text "1st for status, 2nd for X, " (rect 832 200 968 213)(font "Arial" (font_size 8)))
(text "3rd for Y" (rect 832 216 881 229)(font "Arial" (font_size 8)))
(text "Counts to 33, which is when the transfer ends." (rect 744 376 1002 389)(font "Arial" (font_size 8)))
(text "Each data packet is a byte + 3 bits for stop, start" (rect 744 392 1014 405)(font "Arial" (font_size 8)))
(text "and pairity" (rect 744 408 805 421)(font "Arial" (font_size 8)))
(text "Mouse data buffer. After its filled (when dataRead is active) parts of it are stored in regs." (rect 544 520 1033 533)(font "Arial" (font_size 8)))
(text "PS2 CLK low holder" (rect -384 1072 -270 1085)(font "Arial" (font_size 8)))
(text "We count for ~100us and hold PS2CLK low for the duration" (rect -272 1024 59 1037)(font "Arial" (font_size 8)))
(text "to tell the mouse we want to send it info" (rect -272 1040 -51 1053)(font "Arial" (font_size 8)))
(text "Keep control of PS2CLK for ~120us" (rect 296 848 496 861)(font "Arial" (font_size 8)))
(text "Notify holding is done so we start sending data" (rect 320 864 581 877)(font "Arial" (font_size 8)))
(text "reset loads the value we want to send to the mouse into the reg" (rect 224 1008 578 1021)(font "Arial" (font_size 8)))
(text "startDataWrite does the same thing just do be safe" (rect 224 1024 508 1037)(font "Arial" (font_size 8)))
(text "Data read for acknowladge to finish init" (rect 584 784 802 797)(font "Arial" (font_size 8)))
(text "Sending the F4 " (rect 584 1448 673 1461)(font "Arial" (font_size 8)))
