(text "Check if all bits are 0 or 1 to swap current OUT value" (rect 848 568 1145 581)(font "Arial" (font_size 8)))
(text "SL Register with IN as IL" (rect 536 416 676 429)(font "Arial" (font_size 8)))
(text "State keeper/OUT value" (rect 536 568 672 581)(font "Arial" (font_size 8)))
(text "The value of out will change only once" (rect 304 424 517 437)(font "Arial" (font_size 8)))
(text "4 bits of the same value are received" (rect 304 440 510 453)(font "Arial" (font_size 8)))
(text "on IN, so if OUT is 1 and we receive" (rect 304 456 506 469)(font "Arial" (font_size 8)))
(text "1,0,1,1 the OUT stays 1" (rect 304 472 438 485)(font "Arial" (font_size 8)))
