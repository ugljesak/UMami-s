DEPTH = 2048;
WIDTH = 32;
ADDRESS_RADIX = DEC;
DATA_RADIX = HEX;
CONTENT BEGIN
    0 : 00000000;   -- NOP (hard-coded reset value, per spec)
1 : 3E800093; -- addi x1,x0,1000
2 : 0000A103; -- lw x2,x1(0)
3 : 0040A183; -- lw x3,x1(4)
4 : 00C0A203; -- lw x4,x1(C)
5 : 02314133; -- divu x2,x2,x3
6 : 0020A423; -- sw x2, x1(8)
7 : 0000006F; -- end
END;
