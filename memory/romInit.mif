DEPTH = 2048;
WIDTH = 32;
ADDRESS_RADIX = DEC;
DATA_RADIX = HEX;
CONTENT BEGIN
0 : 00000000;  -- NOP
1 : 00004337;  -- lui  x6,4        ; x6 = 16384
2 : 3F000393;  -- addi x7,x0,1008  ; store target = word 252
3 : FFC32283;  -- lw   x5,-4(x6)   ; POLL: read mouse (byte 16380 = word 4095)
4 : 0102D293;  -- srli x5,x5,16    ; pick byte: 0=X, 8=Y, 16=click
5 : 0FF2F293;  -- andi x5,x5,255   ; keep one byte
6 : 0053A023;  -- sw   x5,0(x7)    ; write to word 252
7 : FF1FF06F;  -- jal  x0,-16      ; loop forever
END;
