DEPTH = 2048;
WIDTH = 32;

ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;

CONTENT BEGIN
    0 : 3E800193;   -- addi x3, x0, 1000
    1 : 0001A083;   -- lw   x1, 0(x3)
    2 : 001080B3;   -- add  x1, x1, x1
    3 : 0041A103;   -- lw   x2, 4(x3)
    4 : 002080B3;   -- add  x1, x1, x2
    5 : 0011A423;   -- sw   x1, 8(x3)
    6 : 0000006F;   -- loop: jal x0, 0
END;
